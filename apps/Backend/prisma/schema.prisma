// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
} 

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER  
  ADMIN
}

// ============================================
// CATÁLOGOS (administrador puede agregar)
// ============================================

model Difficulty {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  orderIndex  Int       @default(0) @map("order_index")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relaciones
  texts Text[]
  attempts TypingAttempt[]
  stats UserStatsByDifficulty[]
  usersWithDefault  User[]
  notifications Notification[]

  @@map("difficulties")
}
  
// AGREGADO - Faltaba este modelo
model TextType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  texts Text[]

  @@map("text_types")
}

model Language {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  texts Text[]

  @@map("languages")
}

// ============================================
// USUARIOS
// ============================================

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  defaultDifficultyId Int?        @map("default_difficulty_id")
  defaultDifficulty   Difficulty? @relation(fields: [defaultDifficultyId], references: [id])

  // Relaciones
  attempts      TypingAttempt[]
  sessions      TypingSession[]
  stats         UserStatsByDifficulty[]
  textHistory   UserTextHistory[]
  createdTexts  Text[]
  notifications Notification[]

  @@map("users")
}

// ============================================
// TEXTOS
// ============================================

model Text {
  id           Int      @id @default(autoincrement())
  title        String
  content      String   @db.Text
  difficultyId Int      @map("difficulty_id")
  typeId       Int      @map("type_id")
  languageId   Int      @map("language_id")
  createdById  Int      @map("created_by_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relaciones
  difficulty  Difficulty        @relation(fields: [difficultyId], references: [id])
  type        TextType          @relation(fields: [typeId], references: [id])  // ⭐ AGREGADO
  language    Language          @relation(fields: [languageId], references: [id])
  createdBy   User              @relation(fields: [createdById], references: [id])
  attempts    TypingAttempt[]
  sessions    TypingSession[]
  textHistory UserTextHistory[]

  @@index([difficultyId, typeId, languageId], name: "idx_text_filters")
  @@map("texts")
}

// ============================================
// ESTADÍSTICAS POR DIFICULTAD
// ============================================

model UserStatsByDifficulty {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  difficultyId     Int      @map("difficulty_id")
  bestWpm          Int      @default(0) @map("best_wpm")
  avgWpm           Float    @default(0) @map("avg_wpm")
  avgAccuracy      Float    @default(0) @map("avg_accuracy")
  totalSessions    Int      @default(0) @map("total_sessions")
  totalTimeSeconds Int      @default(0) @map("total_time_seconds")
  avgErrorRate     Float    @default(0) @map("avg_error_rate")
  wpmCount         Int      @default(0) @map("wpm_count")
  accuracyCount    Int      @default(0) @map("accuracy_count")
  errorRateCount   Int      @default(0) @map("error_rate_count")

  // Relaciones
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  difficulty Difficulty @relation(fields: [difficultyId], references: [id])

  @@unique([userId, difficultyId])
  @@index([difficultyId, bestWpm], name: "idx_difficulty_ranking")
  @@map("user_stats_by_difficulty")
}

// ============================================
// SESIONES Y ERRORES
// ============================================

model TypingAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  userId       Int      @map("user_id")
  textId       Int      @map("text_id")
  difficultyId Int     @map("difficulty_id")
  contentHash  String   @map("content_hash")
  eventsHash   String?  @map("events_hash")
  startedAt    DateTime @default(now()) @map("started_at")
  expiresAt    DateTime @map("expires_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         Text          @relation(fields: [textId], references: [id], onDelete: Cascade)
  difficulty   Difficulty    @relation(fields: [difficultyId], references: [id])
  session      TypingSession?

  @@index([difficultyId, userId])
  @@index([userId])
  @@index([textId])
  @@map("typing_attempts")
}

model TypingSession {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  textId          Int      @map("text_id")
  attemptId       String?  @unique @map("attempt_id") @db.Uuid
  wpm             Int?
  accuracy        Float?
  timeSeconds     Int?     @map("time_seconds")
  errorRate       Float?   @map("error_rate")
  improvementRate Float?   @map("improvement_rate")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relaciones
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text   Text          @relation(fields: [textId], references: [id])
  errors TypingError[]
  attempt TypingAttempt? @relation(fields: [attemptId], references: [id], onDelete: NoAction)

  @@index([userId, createdAt], name: "idx_user_sessions")
  @@index([userId, textId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_user_text_sessions")
  @@map("typing_sessions")
}

model TypingError {
  id          Int     @id @default(autoincrement())
  sessionId   Int     @map("session_id")
  wrongWord   String? @map("wrong_word")
  correctWord String? @map("correct_word")
  position    Int?

  // Relaciones
  session TypingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("typing_errors")
}

// ============================================
// HISTORIAL
// ============================================

model UserTextHistory {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  textId        Int      @map("text_id")
  lastAttemptAt DateTime @map("last_attempt_at")
  totalAttempts Int      @default(1) @map("total_attempts")
  bestWpm       Int?     @map("best_wpm")
  bestAccuracy  Float?   @map("best_accuracy")

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  text Text @relation(fields: [textId], references: [id])

  @@unique([userId, textId])
  @@index([userId, lastAttemptAt])
  @@map("user_text_history")
}

// ============================================
// NOTIFICACIONES
// ============================================

model Notification {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  difficultyId Int      @map("difficulty_id")
  wpm          Int
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relaciones
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  difficulty Difficulty @relation(fields: [difficultyId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

# Copia este archivo a .env y completa los valores reales.
# .env nunca se commitea (ya esta en .gitignore).

# Cadena de conexion de PostgreSQL que usa Prisma (prisma/schema.prisma).
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typing_platform?schema=public"

# Secreto para firmar y verificar JWT (auth.module.ts, jwt.strategy.ts, users.module.ts).
# Genera uno propio, no reutilices el de .env.example ni el de otro entorno.
# Ejemplo para generar uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="reemplaza-esto-con-un-secreto-aleatorio-largo"

# Puerto donde escucha el backend NestJS (main.ts). Opcional, default 3000.
PORT=3000

# Controla el flag Secure de la cookie de sesion (auth.controller.ts).
# Sin definir, o con cualquier valor distinto de 'false', la cookie se marca Secure
# (default seguro para cualquier entorno que no sea HTTP plano local).
# Poner en false solo para desarrollo local sobre HTTP plano.
COOKIE_SECURE=false
